// twintell — Phase 1 database schema
// Database: Supabase Postgres | ORM: Prisma | Backend: Express

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supabase pooler URL (port 6543)
  directUrl = env("DIRECT_URL")   // Supabase direct URL (port 5432)
}

enum Role {
  USER
  COMPANY
  ADMIN
}

enum PostTopic {
  BUSINESS_NEWS
  MANUFACTURING
  PRODUCTS
  WHOLESALE
  D2C_BRANDS
  FINANCE
  TECHNOLOGY
  AGRICULTURE
  JOBS
  MEMES
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

// id = Supabase Auth user id (OAuth login ke baad yahi id use hogi)
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String
  avatarUrl String?
  role      Role?    // null = onboarding pending ("Company ho ya User?" screen)
  headline  String?  // "Business Networker | Founder"
  bio       String?
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company?
  likes     Like[]
  comments  Comment[]
  follows   Follow[]
  inquiries Inquiry[]
  inquiryMessages InquiryMessage[]
  notificationsReceived Notification[] @relation("UserNotifications")
  notificationsSent     Notification[] @relation("ActorNotifications")
  payments  Payment[]
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique // "Textiles & Clothing", "Chemicals" ...
  slug      String    @unique
  icon      String?
  companies Company[]
  products  Product[]
  posts     Post[]
}

model Company {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @db.Uuid
  name          String
  slug          String   @unique
  logoUrl       String?
  coverUrl      String?
  businessType  String   // "Manufacturer", "Supplier", "Wholesaler"
  categoryId    String?  @db.Uuid
  city          String
  state         String
  description   String?
  tags          String[] // ["Packaging", "Custom Boxes", "Eco Friendly"]
  yearFounded   Int?
  gstin         String?  // 15-character GST identification number for auto-verification
  verified      Boolean  @default(false)
  followerCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id])
  products     Product[]
  posts        Post[]
  followers    Follow[]
  inquiries    Inquiry[]
  subscription Subscription?
  payments     Payment[]
  sponsoredAds SponsoredAd[]

  @@index([categoryId])
  @@index([city])
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  categoryId  String?  @db.Uuid
  title       String
  description String?
  price       Decimal? @db.Decimal(12, 2)
  priceUnit   String?  // "piece", "kg"
  moq         Int?     // Minimum order quantity
  images      String[]
  tags        String[] // ["Eco Friendly", "Custom Printing", "Bulk Order"]
  material    String?
  sizes       String?
  usage       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id])
  inquiries Inquiry[]

  @@index([companyId])
  @@index([categoryId])
  @@index([createdAt(sort: Desc)])
}

model Post {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  categoryId   String?   @db.Uuid
  content      String
  images       String[]
  topic        PostTopic @default(BUSINESS_NEWS)
  likeCount    Int       @default(0)
  commentCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category      Category?      @relation(fields: [categoryId], references: [id])
  likes         Like[]
  comments      Comment[]
  notifications Notification[]

  @@index([createdAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([categoryId, createdAt(sort: Desc)])
  @@index([topic, createdAt(sort: Desc)])
}

model Like {
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  content   String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model Follow {
  userId    String   @db.Uuid
  companyId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@index([companyId])
}

// "Contact Supplier" button — user company ko inquiry bhejta hai
model Inquiry {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  companyId String   @db.Uuid
  productId String?  @db.Uuid
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product  Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  messages InquiryMessage[]

  @@index([companyId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model InquiryMessage {
  id        String   @id @default(uuid()) @db.Uuid
  inquiryId String   @db.Uuid
  senderId  String   @db.Uuid
  content   String
  createdAt DateTime @default(now())

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([inquiryId, createdAt(sort: Asc)])
}

// ---------- Subscriptions (future phase — tables ready, limits from DB) ----------

// Plans: FREE, PRO, ENTERPRISE ... Limits yahan se aayengi, code mein hardcode nahi.
// null limit = unlimited
model Plan {
  id                 String   @id @default(uuid()) @db.Uuid
  code               String   @unique // "FREE", "PRO", "ADVERTISING", "LEAD_GEN"
  name               String
  tagline            String?
  priceYearly        Decimal  @default(0) @db.Decimal(10, 2)
  priceMonthly       Decimal  @default(0) @db.Decimal(10, 2)
  postsPerMonth      Int?
  productsLimit      Int?
  features           String[] @default([])
  badge              String?  // e.g. "Recommended"
  isPopular          Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  subscriptions Subscription[]
  payments      Payment[]
}

// Har company ki ek current subscription. Phase 1 mein sab FREE plan pe.
model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  companyId          String             @unique @db.Uuid
  planId             String             @db.Uuid
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime?
  providerRef        String?            // Razorpay subscription id (baad mein)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id])

  @@index([planId])
}

enum NotificationType {
  LIKE
  FOLLOW
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  actorId   String           @db.Uuid
  type      NotificationType
  postId    String?          @db.Uuid
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user  User  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor User  @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: Cascade)
  post  Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([actorId])
  @@index([postId])
}

// ---------- Admin & Payments & In-Feed Advertising ----------

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  companyId   String?       @db.Uuid
  userId      String?       @db.Uuid
  planId      String?       @db.Uuid
  amount      Decimal       @db.Decimal(10, 2)
  currency    String        @default("INR")
  gateway     String        @default("RAZORPAY") // RAZORPAY, MANUAL, UPI
  orderId     String?       @unique
  paymentId   String?       @unique
  signature   String?
  status      PaymentStatus @default(PENDING)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company     Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  plan        Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([status])
}

enum AdStatus {
  ACTIVE
  PAUSED
  EXPIRED
}

model SponsoredAd {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String?   @db.Uuid
  title       String
  description String
  imageUrl    String
  ctaText     String    @default("Learn More")
  ctaUrl      String
  category    String?   // optional targeted business category
  status      AdStatus  @default(ACTIVE)
  impressions Int       @default(0)
  clicks      Int       @default(0)
  startDate   DateTime  @default(now())
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company     Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([status, startDate, endDate])
  @@index([category])
}

