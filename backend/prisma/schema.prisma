// twintell — Phase 1 database schema
// Database: Supabase Postgres | ORM: Prisma | Backend: Express

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supabase pooler URL (port 6543)
  directUrl = env("DIRECT_URL")   // Supabase direct URL (port 5432)
}

enum Role {
  USER
  COMPANY
}

enum PostTopic {
  BUSINESS_NEWS
  MANUFACTURING
  PRODUCTS
  WHOLESALE
  D2C_BRANDS
  FINANCE
  TECHNOLOGY
  AGRICULTURE
  JOBS
  MEMES
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

// id = Supabase Auth user id (OAuth login ke baad yahi id use hogi)
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String
  avatarUrl String?
  role      Role?    // null = onboarding pending ("Company ho ya User?" screen)
  headline  String?  // "Business Networker | Founder"
  bio       String?
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company?
  likes     Like[]
  comments  Comment[]
  follows   Follow[]
  inquiries Inquiry[]
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique // "Textiles & Clothing", "Chemicals" ...
  slug      String    @unique
  icon      String?
  companies Company[]
  products  Product[]
}

model Company {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @db.Uuid
  name          String
  slug          String   @unique
  logoUrl       String?
  coverUrl      String?
  businessType  String   // "Manufacturer", "Supplier", "Wholesaler"
  categoryId    String?  @db.Uuid
  city          String
  state         String
  description   String?
  tags          String[] // ["Packaging", "Custom Boxes", "Eco Friendly"]
  yearFounded   Int?
  verified      Boolean  @default(false)
  followerCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id])
  products     Product[]
  posts        Post[]
  followers    Follow[]
  inquiries    Inquiry[]
  subscription Subscription?

  @@index([categoryId])
  @@index([city])
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  categoryId  String?  @db.Uuid
  title       String
  description String?
  price       Decimal? @db.Decimal(12, 2)
  priceUnit   String?  // "piece", "kg"
  moq         Int?     // Minimum order quantity
  images      String[]
  tags        String[] // ["Eco Friendly", "Custom Printing", "Bulk Order"]
  material    String?
  sizes       String?
  usage       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id])
  inquiries Inquiry[]

  @@index([companyId])
  @@index([categoryId])
  @@index([createdAt(sort: Desc)])
}

model Post {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  content      String
  images       String[]
  topic        PostTopic
  likeCount    Int       @default(0)
  commentCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  likes    Like[]
  comments Comment[]

  @@index([createdAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([topic, createdAt(sort: Desc)])
}

model Like {
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  content   String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model Follow {
  userId    String   @db.Uuid
  companyId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@index([companyId])
}

// "Contact Supplier" button — user company ko inquiry bhejta hai
model Inquiry {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  companyId String   @db.Uuid
  productId String?  @db.Uuid
  message   String
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt(sort: Desc)])
}

// ---------- Subscriptions (future phase — tables ready, limits from DB) ----------

// Plans: FREE, PRO, ENTERPRISE ... Limits yahan se aayengi, code mein hardcode nahi.
// null limit = unlimited
model Plan {
  id                 String   @id @default(uuid()) @db.Uuid
  code               String   @unique // "FREE", "PRO", "ENTERPRISE"
  name               String
  priceMonthly       Decimal  @default(0) @db.Decimal(10, 2)
  postsPerMonth      Int?
  productsLimit      Int?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  subscriptions Subscription[]
}

// Har company ki ek current subscription. Phase 1 mein sab FREE plan pe.
model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  companyId          String             @unique @db.Uuid
  planId             String             @db.Uuid
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime?
  providerRef        String?            // Razorpay subscription id (baad mein)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id])

  @@index([planId])
}
